# Copia este archivo a .env y reemplaza los valores antes de correr la app.
# NUNCA subas el archivo .env real al repositorio (ya esta en .gitignore).

# Clave secreta para firmar los tokens JWT.
# Generarla con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplaza-esta-clave-por-una-generada-aleatoriamente

# Algoritmo de firma para los tokens JWT
ALGORITHM=HS256

# Minutos de vigencia del access token
ACCESS_TOKEN_EXPIRE_MINUTES=30
